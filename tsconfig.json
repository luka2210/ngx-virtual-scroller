{
  "compilerOptions": {
    "baseUrl": "./src",
    "sourceMap": true,
    "declaration": true,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "useDefineForClassFields": false,
    "strictNullChecks": false,
    "lib": [
      "ES2022",
      "dom"
    ]
  },
  "exclude": [
    "node_modules",
    "demo",
    "dist"
  ],
  "compileOnSave": false
}
